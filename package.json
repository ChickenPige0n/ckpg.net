{
  "name": "fuwari",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check && node scripts/check-lang-siblings.js",
    "prebuild": "node scripts/check-lang-siblings.js",
    "check:langs": "node scripts/check-lang-siblings.js",
    "build": "astro build && pagefind --site dist/client --output-path dist/client/pagefind",
    "preview": "astro preview",
    "preview:cf": "wrangler dev dist/server/entry.mjs --config dist/server/wrangler.json --no-bundle",
    "astro": "astro",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/new-post.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.1.6",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@expressive-code/core": "^0.44.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.87",
    "@iconify/svelte": "^5.2.2",
    "@myriaddreamin/typst-ts-node-compiler": "^0.8.0-rc3",
    "@myriaddreamin/typst-ts-renderer": "^0.8.0-rc3",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.5",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "astro-typst": "^0.12.3",
    "hastscript": "^9.0.1",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "mdast-util-to-string": "^4.0.0",
    "node-gyp": "^13.0.1",
    "overlayscrollbars": "^2.16.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^1.0.0",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "stylus": "^0.64.0",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@biomejs/biome": "2.5.6",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.1",
    "wrangler": "^4.115.0"
  },
  "packageManager": "pnpm@9.14.4"
}
