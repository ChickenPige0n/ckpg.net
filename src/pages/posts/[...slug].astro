---
import { render } from "astro:content";
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import {
	getTranslation,
	isEnglishLang,
	renderTemplate,
} from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getLangSiblingId, getSortedPosts } from "@utils/content-utils";
import { getContentDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { licenseConfig, profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = [
		...(await getSortedPosts()),
		...(await getSortedPosts("en")),
	];
	const ids = new Set(blogEntries.map((entry) => entry.id));
	return blogEntries.map((entry) => {
		const langSiblingId = getLangSiblingId(entry.id);
		return {
			params: { slug: entry.id },
			props: {
				entry,
				langSiblingId: ids.has(langSiblingId) ? langSiblingId : "",
			},
		};
	});
}

const { entry, langSiblingId = "" } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const postLang = entry.data.lang || siteConfig.lang;
const t = getTranslation(postLang);
const english = isEnglishLang(postLang);

const postIsZh = !english;
const zhHref = postIsZh
	? ""
	: langSiblingId
		? getPostUrlBySlug(langSiblingId)
		: "";
const enHref = postIsZh
	? langSiblingId
		? getPostUrlBySlug(langSiblingId)
		: ""
	: "";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	...(entry.data.translatedBy
		? {
				translator: {
					"@type": "Organization",
					name: entry.data.translatedBy,
				},
			}
		: {}),
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={postLang} setOGTypeArticle={true} headings={headings} langSwitchHref={langSiblingId ? getPostUrlBySlug(langSiblingId) : ""}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <article id="post-container" class="w-full relative mb-8">
        <!-- Top Swiss Editorial Metadata Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-3 mb-6 border-b border-(--ink-strong) onload-animation">
            <div class="flex items-center gap-4 swiss-num text-xs text-(--ink-muted)">
                <span>{remarkPluginFrontmatter.words} {t[I18nKey.wordsCount]}</span>
                <span>{remarkPluginFrontmatter.minutes} {t[remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount]}</span>
            </div>

            {(zhHref || enHref) && (
                <div class="flex items-center gap-2 text-xs swiss-num">
                    <span class="text-(--ink-faint) hidden sm:inline uppercase" data-i18n="articleLanguage">{t[I18nKey.articleLanguage]}</span>
                    <div class="flex items-center border border-(--line-divider)">
                        {postIsZh ? (
                            <span class="px-2.5 h-6 inline-flex items-center bg-(--ink-strong) text-(--page-bg) font-medium">中文</span>
                        ) : zhHref ? (
                            <a href={zhHref} data-no-swup data-lang-switch="zh" aria-label="Read this article in Chinese"
                               class="px-2.5 h-6 inline-flex items-center text-(--ink-muted) hover:text-(--ink-strong) transition-colors">中文</a>
                        ) : null}
                        {!postIsZh ? (
                            <span class="px-2.5 h-6 inline-flex items-center bg-(--ink-strong) text-(--page-bg) font-medium">EN</span>
                        ) : enHref ? (
                            <a href={enHref} data-no-swup data-lang-switch="en" aria-label="Read this article in English"
                               class="px-2.5 h-6 inline-flex items-center text-(--ink-muted) hover:text-(--ink-strong) transition-colors">EN</a>
                        ) : null}
                    </div>
                </div>
            )}
        </div>

        <!-- Title -->
        <header class="mb-8 onload-animation">
            <h1
                data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                data-pagefind-filter="lang" data-pagefind-filter-value={english ? "en" : "zh"}
                class="font-bold text-3xl md:text-4xl lg:text-[2.65rem] leading-[1.2] text-(--ink-strong) mb-5"
            >
                {entry.data.title}
            </h1>

            <PostMetadata
                class="mb-3"
                published={entry.data.published}
                updated={entry.data.updated}
                tags={entry.data.tags}
                category={entry.data.category}
                lang={postLang}
            ></PostMetadata>

            {entry.data.translatedBy && (
                <div class="flex items-center gap-1.5 text-xs swiss-num text-(--ink-muted) mt-2">
                    <Icon name="material-symbols:translate-rounded" class="text-sm"></Icon>
                    <span>{renderTemplate(t[I18nKey.translatedBy], { translatedBy: entry.data.translatedBy })}</span>
                </div>
            )}

            <div class="border-b border-(--line-divider) mt-6"></div>
        </header>

        {entry.data.image && (
            <ImageWrapper
                id="post-cover"
                src={entry.data.image}
                basePath={path.join("content/posts/", getContentDir(entry.id))}
                class="mb-8 border border-(--line-divider) banner-container onload-animation"
            />
        )}

        <Markdown class="mb-10 markdown-content onload-animation">
            <Content />
        </Markdown>

        {licenseConfig.enable && (
            <License
                title={entry.data.title}
                slug={entry.id}
                pubDate={entry.data.published}
                lang={postLang}
                class="mb-6 license-container onload-animation"
            ></License>
        )}
    </article>

    <!-- Previous and Next Navigation -->
    {(entry.data.nextSlug || entry.data.prevSlug) && (
        <nav class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6 border-t border-(--line-divider)">
            <div>
                {entry.data.nextSlug && (
                    <a href={getPostUrlBySlug(entry.data.nextSlug)}
                       class="group block p-4 border border-(--line-divider) hover:border-(--ink-strong) transition-colors duration-200">
                        <div class="swiss-label mb-1 flex items-center gap-1">
                            <Icon name="material-symbols:arrow-back-rounded" class="text-sm transition-transform duration-200 group-hover:-translate-x-0.5" />
                            <span>NEWER</span>
                        </div>
                        <div class="font-medium text-sm text-(--ink-strong) group-hover:text-(--primary) transition-colors truncate">
                            {entry.data.nextTitle}
                        </div>
                    </a>
                )}
            </div>

            <div>
                {entry.data.prevSlug && (
                    <a href={getPostUrlBySlug(entry.data.prevSlug)}
                       class="group block p-4 border border-(--line-divider) hover:border-(--ink-strong) transition-colors duration-200 text-right">
                        <div class="swiss-label mb-1 flex items-center justify-end gap-1">
                            <span>OLDER</span>
                            <Icon name="material-symbols:arrow-forward-rounded" class="text-sm transition-transform duration-200 group-hover:translate-x-0.5" />
                        </div>
                        <div class="font-medium text-sm text-(--ink-strong) group-hover:text-(--primary) transition-colors truncate">
                            {entry.data.prevTitle}
                        </div>
                    </a>
                )}
            </div>
        </nav>
    )}
</MainGridLayout>
