---
import { render } from "astro:content";
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import {
	getTranslation,
	isEnglishLang,
	renderTemplate,
} from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getLangSiblingId, getSortedPosts } from "@utils/content-utils";
import { getContentDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { licenseConfig, profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = [
		...(await getSortedPosts()),
		...(await getSortedPosts("en")),
	];
	const ids = new Set(blogEntries.map((entry) => entry.id));
	return blogEntries.map((entry) => {
		const langSiblingId = getLangSiblingId(entry.id);
		return {
			params: { slug: entry.id },
			props: {
				entry,
				langSiblingId: ids.has(langSiblingId) ? langSiblingId : "",
			},
		};
	});
}

const { entry, langSiblingId = "" } = Astro.props;
const { Content, headings } = await render(entry);

// Utility strings on the post page follow the post's own language.
const postLang = entry.data.lang || siteConfig.lang;
const t = getTranslation(postLang);
const english = isEnglishLang(postLang);

// Available translations of this article (zh original / en mirror).
const postIsZh = !english;
const zhHref = postIsZh
	? ""
	: langSiblingId
		? getPostUrlBySlug(langSiblingId)
		: "";
const enHref = postIsZh
	? langSiblingId
		? getPostUrlBySlug(langSiblingId)
		: ""
	: "";

const { remarkPluginFrontmatter } = await render(entry);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	...(entry.data.translatedBy
		? {
				translator: {
					"@type": "Organization",
					name: entry.data.translatedBy,
				},
			}
		: {}),
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={postLang} setOGTypeArticle={true} headings={headings} langSwitchHref={langSiblingId ? getPostUrlBySlug(langSiblingId) : ""}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
        <div id="post-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row items-center justify-between mb-3 transition onload-animation">
                <div class="flex flex-row text-black/30 dark:text-white/30 gap-5">
                    <div class="flex flex-row items-center">
                        <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                            <Icon name="material-symbols:notes-rounded"></Icon>
                        </div>
                        <div class="text-sm">{remarkPluginFrontmatter.words} {" " + t[I18nKey.wordsCount]}</div>
                    </div>
                    <div class="flex flex-row items-center">
                        <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                            <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                        </div>
                        <div class="text-sm">
                            {remarkPluginFrontmatter.minutes} {" " + t[remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount]}
                        </div>
                    </div>
                </div>
                    {(zhHref || enHref) && (
                        <div class="flex flex-row items-center gap-2 text-sm shrink-0 ml-4">
                            <span class="text-black/40 dark:text-white/40 hidden sm:inline" data-i18n="articleLanguage">{t[I18nKey.articleLanguage]}</span>
                            <div class="flex flex-row items-center gap-1">
                                {postIsZh ? (
                                    <span class="btn-plain scale-animation current-theme-btn rounded-lg h-7 px-2.5 text-xs font-bold">中文</span>
                                ) : zhHref ? (
                                    <a href={zhHref} data-no-swup data-lang-switch="zh" aria-label="Read this article in Chinese"
                                       class="btn-plain scale-animation rounded-lg h-7 px-2.5 text-xs font-bold active:scale-95">中文</a>
                                ) : null}
                                {!postIsZh ? (
                                    <span class="btn-plain scale-animation current-theme-btn rounded-lg h-7 px-2.5 text-xs font-bold">English</span>
                                ) : enHref ? (
                                    <a href={enHref} data-no-swup data-lang-switch="en" aria-label="Read this article in English"
                                       class="btn-plain scale-animation rounded-lg h-7 px-2.5 text-xs font-bold active:scale-95">English</a>
                                ) : null}
                            </div>
                        </div>
                    )}
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    data-pagefind-filter="lang" data-pagefind-filter-value={english ? "en" : "zh"}
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                    before:absolute before:top-3 before:-left-4.5
                ">
                    {entry.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                        lang={postLang}
                ></PostMetadata>
                {entry.data.translatedBy && (
                    <div class="flex items-center gap-1.5 text-sm text-black/40 dark:text-white/40 mb-3">
                        <Icon name="material-symbols:translate-rounded" class="text-base"></Icon>
                        <span>{renderTemplate(t[I18nKey.translatedBy], { translatedBy: entry.data.translatedBy })}</span>
                    </div>
                )}
                {!entry.data.image && <div class="border-(--line-divider) border-dashed border-b mb-5"></div>}
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getContentDir(entry.id))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.id} pubDate={entry.data.published} lang={postLang} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug && <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-(--primary)" />
                <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug && <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
                <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-(--primary)" />
            </div>}
        </a>
    </div>

</MainGridLayout>
