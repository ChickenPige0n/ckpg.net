---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { getTranslation } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../../utils/content-utils";

const sortedPostsList = await getSortedPostsList("en");
const t = getTranslation("en");
---

<MainGridLayout lang="en" title={t[I18nKey.archive]}>
    <ArchivePanel sortedPosts={sortedPostsList} tags={[]} categories={[]} lang="en" client:only="svelte"></ArchivePanel>
</MainGridLayout>
