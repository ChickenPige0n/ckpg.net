---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../../config";
import { getAboutUrl } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const lang = Astro.props.lang || siteConfig.lang;
---
<div>
    <div class="flex items-center gap-3.5 lg:block">
        <a aria-label="Go to About Page" href={getAboutUrl(lang)}
           class="group block relative w-16 h-16 lg:w-24 lg:h-24 shrink-0 overflow-hidden border border-(--line-divider) hover:border-(--ink-strong) transition-colors lg:mb-4">
            <div class="absolute inset-0 transition-opacity duration-200 pointer-events-none bg-black/40 opacity-0 group-hover:opacity-100
            z-20 flex items-center justify-center">
                <Icon name="material-symbols:arrow-outward-rounded"
                      class="text-white text-xl">
                </Icon>
            </div>
            <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="w-full h-full"></ImageWrapper>
        </a>
        <div>
            <a href={getAboutUrl(lang)} class="font-semibold text-base text-(--ink-strong) hover:text-(--primary) transition-colors block">
                {config.name}
            </a>
            <div class="text-xs leading-relaxed text-(--ink-muted) mt-1">{config.bio}</div>
        </div>
    </div>

    <div class="flex flex-wrap gap-1.5 mt-4">
        {config.links.map(item =>
            <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="h-8 w-8 flex items-center justify-center border border-(--line-divider) hover:border-(--ink-strong) text-(--ink-muted) hover:text-(--ink-strong) transition-colors duration-200">
                <Icon name={item.icon} class="text-[1rem]"></Icon>
            </a>
        )}
    </div>
</div>
