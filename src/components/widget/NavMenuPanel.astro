---
import { Icon } from "astro-icon/components";
import I18nKey from "../../i18n/i18nKey";
import { getTranslation } from "../../i18n/translation";
import { UI_LANGS } from "../../i18n/ui-language";
import type { NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";

interface Props {
	links: NavBarLink[];
	lang?: string;
}

const { links, lang = "zh_CN" } = Astro.props;
const t = getTranslation(lang);
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed absolute right-0 top-16 w-64 p-3 z-50"]}>
    <div class="divide-y divide-(--line-divider)">
        {links.map((link) => (
            <a href={link.external ? link.url : url(link.url)} class="group flex justify-between items-center py-2.5 px-2
                hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active) transition-colors
            "
               target={link.external ? "_blank" : null}
            >
                <div class="text-sm font-medium text-(--ink-strong) group-hover:text-(--primary) transition-colors">
                    <span data-i18n={link.i18nKey}>{link.name}</span>
                </div>
                {!link.external && <Icon name="material-symbols:arrow-forward-rounded"
                      class="transition-transform duration-200 group-hover:translate-x-0.5 text-[1rem] text-(--ink-muted) group-hover:text-(--primary)"
                >
                </Icon>}
                {link.external && <Icon name="material-symbols:arrow-outward-rounded"
                      class="text-[0.95rem] text-(--ink-faint)"
                >
                </Icon>}
            </a>
        ))}
    </div>
    <div class="border-(--line-divider) border-t mt-2 pt-2.5">
        <div class="flex items-center gap-1.5 px-2 py-1 swiss-label" data-i18n="uiLanguage">
            <Icon name="material-symbols:globe" class="text-sm"></Icon>
            {t[I18nKey.uiLanguage]}
        </div>
        <div class="grid grid-cols-2 gap-1 mt-1 max-h-56 overflow-y-auto">
            {UI_LANGS.map((l) => (
                <button type="button" data-ui-lang={l.code}
                        class="flex transition-colors whitespace-nowrap items-center justify-between w-full btn-plain scale-animation h-8 px-2 text-xs font-medium">
                    <span>{l.label}</span>
                    <Icon name="material-symbols:check-rounded" class="ui-lang-check hidden text-[0.95rem] text-(--primary)"></Icon>
                </button>
            ))}
        </div>
    </div>
</div>

<script>
	import { currentUiLang, selectUiLang } from "../../i18n/ui-lang-client";

	function initMobileUiLangs() {
		const panel = document.getElementById("nav-menu-panel");
		if (!panel) return;

		const current = currentUiLang();
		panel.querySelectorAll("[data-ui-lang]").forEach((el) => {
			const code = el.getAttribute("data-ui-lang");
			if (code === current) {
				el.classList.add("current-theme-btn");
				const check = el.querySelector(".ui-lang-check");
				if (check) check.classList.remove("hidden");
			}
			el.addEventListener("click", () => {
				selectUiLang(code || "");
			});
		});
	}

	initMobileUiLangs();
</script>
