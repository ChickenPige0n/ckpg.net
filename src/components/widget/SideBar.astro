---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	lang?: string;
}

const className = Astro.props.class;
const pageLang = Astro.props.lang || siteConfig.lang;
---
<aside id="sidebar" class:list={[className, "w-full"]}>
    <div class="w-full pb-6 border-b border-(--line-divider) mb-6">
        <Profile lang={pageLang}></Profile>
    </div>
    <div id="sidebar-sticky" class="flex flex-col w-full gap-6 top-22 sticky">
        <Categories class="onload-animation" style="animation-delay: 100ms" lang={pageLang}></Categories>
        <Tag class="onload-animation" style="animation-delay: 150ms" lang={pageLang}></Tag>
    </div>
</aside>
