---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	lang?: string;
}

const className = Astro.props.class;
const pageLang = Astro.props.lang || siteConfig.lang;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile lang={pageLang}></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky">
        <Categories class="onload-animation" style="animation-delay: 150ms" lang={pageLang}></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms" lang={pageLang}></Tag>
    </div>
</div>
