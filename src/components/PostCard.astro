---
import { type CollectionEntry, render } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { getTranslation } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getContentDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await render(entry);
const postLang = (entry.data as { lang?: string }).lang || siteConfig.lang;
const t = getTranslation(postLang);
---
<article class:list={["group py-7 md:py-8 relative transition-colors duration-200", className]} style={style}>
    <div class:list={["grid grid-cols-1 gap-y-3 md:gap-x-6 items-start", hasCover ? "md:grid-cols-[7.5rem_minmax(0,1fr)_11rem]" : "md:grid-cols-[7.5rem_minmax(0,1fr)"]}>
        <!-- Left column: Date & Category -->
        <div class="flex md:flex-col items-center md:items-start gap-3 md:gap-1.5 pt-0.5">
            <time datetime={published.toISOString()} class="swiss-num text-xs text-(--ink-muted)">
                {formatDateToYYYYMMDD(published)}
            </time>
            <a href={getCategoryUrl(category, postLang)} aria-label={`View all posts in the ${category} category`}
               class="swiss-label text-(--ink-muted) hover:text-(--primary) transition-colors">
                {category ? category : <span data-i18n="uncategorized">{t[I18nKey.uncategorized]}</span>}
            </a>
        </div>

        <!-- Center column: Title, Excerpt, Tags & Read Stats -->
        <div class="min-w-0">
            <a href={url} class="block group/title">
                <h2 class="text-xl md:text-2xl font-semibold tracking-[-0.02em] leading-snug text-(--ink-strong) group-hover/title:text-(--primary) transition-colors duration-200 inline-flex items-baseline gap-2">
                    <span>{title}</span>
                    <Icon name="material-symbols:arrow-forward-rounded" class="text-lg shrink-0 text-(--primary) opacity-0 -translate-x-1.5 group-hover/title:opacity-100 group-hover/title:translate-x-0 transition-all duration-200 translate-y-0.5" />
                </h2>
            </a>

            <p class:list={["text-sm md:text-[0.95rem] leading-relaxed text-(--ink-muted) mt-2", {"line-clamp-2": !description}]}>
                {description || remarkPluginFrontmatter.excerpt}
            </p>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 mt-3.5 text-xs swiss-num text-(--ink-faint)">
                <span>
                    {remarkPluginFrontmatter.words} {t[remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount]}
                </span>
                <span>·</span>
                <span>
                    {remarkPluginFrontmatter.minutes} {t[remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount]}
                </span>
                {tags && tags.length > 0 && (
                    <>
                        <span class="hidden sm:inline">·</span>
                        <div class="hidden sm:flex flex-wrap gap-2">
                            {tags.map((tag) => (
                                <a href={getTagUrl(tag, postLang)} class="text-(--ink-muted) hover:text-(--primary) transition-colors">
                                    #{tag.trim()}
                                </a>
                            ))}
                        </div>
                    </>
                )}
            </div>
        </div>

        <!-- Optional Right column: Crisp Rectangular Cover -->
        {hasCover && (
            <a href={url} aria-label={title} class="block w-full aspect-16/10 md:aspect-4/3 overflow-hidden border border-(--line-divider) group-hover:border-(--ink-strong) transition-colors">
                <ImageWrapper
                    src={image}
                    basePath={path.join("content/posts/", getContentDir(entry.id))}
                    alt="Cover Image of the Post"
                    class="w-full h-full transition-transform duration-500 ease-out group-hover:scale-105"
                />
            </a>
        )}
    </div>
</article>
