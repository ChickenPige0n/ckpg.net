---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import { isEnglishLang } from "../i18n/translation";
import { getAboutUrl, getArchiveUrl, getBlogUrl } from "../utils/url-utils";

interface Props {
	lang?: string;
}

const lang = Astro.props.lang || siteConfig.lang;
const english = isEnglishLang(lang);
const copy = english
	? { articles: "Read Articles", archive: "Full Archive", about: "Biography" }
	: { articles: "阅读文章", archive: "全部归档", about: "关于作者" };
---

<section class="intro-page" aria-labelledby="intro-name">
	<h1 id="intro-name" class="intro-title">ChickenPige0n</h1>
	<p class="intro-greeting" lang="en">Hello World.</p>
	<div class="flex flex-wrap items-center gap-3 mt-8">
		<a
			href={getBlogUrl(lang)}
			class="inline-flex items-center gap-2.5 h-11 px-5 bg-(--ink-strong) text-(--page-bg) text-sm font-medium transition-colors duration-200 hover:bg-(--primary) hover:text-white"
		>
			<span>{copy.articles}</span>
			<Icon name="material-symbols:arrow-forward-rounded" class="text-base" />
		</a>
		<a
			href={getArchiveUrl(lang)}
			class="inline-flex items-center h-11 px-5 border border-(--line-color) hover:border-(--ink-strong) text-(--ink-strong) text-sm font-medium transition-colors duration-200"
		>
			{copy.archive}
		</a>
		<a
			href={getAboutUrl(lang)}
			class="inline-flex items-center h-11 px-3 text-sm text-(--ink-muted) hover:text-(--ink-strong) transition-colors duration-200"
		>
			{copy.about}
		</a>
	</div>
</section>

<style>
	.intro-page {
		display: flex;
		min-height: clamp(20rem, 58svh, 38rem);
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding-block: clamp(3rem, 8svh, 6rem);
	}

	.intro-title {
		margin: 0;
		color: var(--ink-strong);
		font-size: 2.25rem;
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.15;
	}

	.intro-greeting {
		margin: 1.5rem 0 0;
		color: var(--ink-muted);
		font-size: 1.25rem;
		line-height: 1.5;
	}

	@media (min-width: 40rem) {
		.intro-title {
			font-size: 3.5rem;
		}
	}

	@media (min-width: 64rem) {
		.intro-title {
			font-size: 5.25rem;
		}

		.intro-greeting {
			font-size: 1.5rem;
		}
	}
</style>
