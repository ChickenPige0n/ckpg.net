---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	const base = Astro.url.pathname.startsWith("/en/") ? "/en/blog/" : "/blog/";
	if (p === 1) return base;
	return `${base}${p}/`;
};
---

<div class:list={[className, "flex flex-row gap-2 justify-between items-center pt-4 swiss-num text-xs"]} style={style}>
    <a href={page.url.prev || ""} aria-label={page.url.prev ? "Previous Page" : null}
       class:list={["btn-card px-3 h-9 gap-1 text-(--ink-strong)",
           {"disabled": page.url.prev == undefined}
       ]}
    >
        <Icon name="material-symbols:arrow-back-rounded" class="text-[1rem]"></Icon>
        <span>PREV</span>
    </a>
    <div class="flex flex-row items-center gap-1">
        {pages.map((p) => {
            if (p == HIDDEN)
                return <Icon name="material-symbols:more-horiz" class="mx-1 text-(--ink-muted)"/>;
            if (p == page.currentPage)
                return <div class="h-9 w-9 bg-(--ink-strong) text-(--page-bg) flex items-center justify-center font-semibold">
                    {String(p).padStart(2, "0")}
                </div>
            return <a href={url(getPageUrl(p))} aria-label={`Page ${p}`}
                class="btn-card w-9 h-9 text-(--ink-body)"
            >{String(p).padStart(2, "0")}</a>
        })}
    </div>
    <a href={page.url.next || ""} aria-label={page.url.next ? "Next Page" : null}
       class:list={["btn-card px-3 h-9 gap-1 text-(--ink-strong)",
           {"disabled": page.url.next == undefined}
       ]}
    >
        <span>NEXT</span>
        <Icon name="material-symbols:arrow-forward-rounded" class="text-[1rem]"></Icon>
    </a>
</div>
