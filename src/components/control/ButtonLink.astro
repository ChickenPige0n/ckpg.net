---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label} class="group flex items-center justify-between py-1.5 text-sm text-(--ink-body) hover:text-(--primary) transition-colors duration-200 border-b border-(--line-divider)/60 last:border-b-0">
    <span class="overflow-hidden text-left whitespace-nowrap text-ellipsis group-hover:translate-x-0.5 transition-transform duration-200">
        <slot></slot>
    </span>
    {badge !== undefined && badge !== null && badge !== '' && (
        <span class="swiss-num text-xs text-(--ink-muted) group-hover:text-(--primary) ml-3 shrink-0">
            {badge.padStart(2, "0")}
        </span>
    )}
</a>
