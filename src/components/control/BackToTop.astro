---
import { Icon } from "astro-icon/components";
---

<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center transition-all duration-200" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card bg-(--page-bg)! h-10 w-10 text-(--ink-strong) hover:text-(--primary)">
            <Icon name="material-symbols:arrow-upward-rounded" class="mx-auto text-lg"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 2.5rem
    height: 2.5rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    position: fixed
    bottom: 2.5rem
    right: 2.5rem
    opacity: 1
    cursor: pointer
    pointer-events: auto
    &.hide
        transform: translateY(0.5rem)
        opacity: 0
        pointer-events: none
    &:active
        transform: scale(0.95)
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
