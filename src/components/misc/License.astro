---
import { licenseConfig, profileConfig, siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { getTranslation } from "../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	class: string;
	lang?: string;
}

const { title, pubDate, lang } = Astro.props;
const className = Astro.props.class;
const profileConf = profileConfig;
const licenseConf = licenseConfig;
const postUrl = decodeURIComponent(Astro.url.toString());
const t = getTranslation(lang || siteConfig.lang);
---
<div class={`relative border border-(--line-divider) bg-(--license-block-bg) py-5 px-6 ${className}`}>
    <div class="font-semibold text-sm text-(--ink-strong) mb-0.5">
        {title}
    </div>
    <a href={postUrl} class="swiss-num text-xs text-(--ink-muted) hover:text-(--primary) transition-colors break-all">
        {postUrl}
    </a>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4 pt-4 border-t border-(--line-divider)">
        <div>
            <div class="swiss-label mb-0.5" data-i18n="author">{t[I18nKey.author]}</div>
            <div class="text-xs font-medium text-(--ink-body)">{profileConf.name}</div>
        </div>
        <div>
            <div class="swiss-label mb-0.5" data-i18n="publishedAt">{t[I18nKey.publishedAt]}</div>
            <div class="swiss-num text-xs text-(--ink-body)">{formatDateToYYYYMMDD(pubDate)}</div>
        </div>
        <div>
            <div class="swiss-label mb-0.5" data-i18n="license">{t[I18nKey.license]}</div>
            <a href={licenseConf.url} target="_blank" class="swiss-num text-xs font-medium text-(--ink-strong) hover:text-(--primary) transition-colors">{licenseConf.name}</a>
        </div>
    </div>
</div>
