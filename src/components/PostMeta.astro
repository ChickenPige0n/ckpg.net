---
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { getTranslation } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
	lang?: string;
}
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
	lang,
} = Astro.props;
const className = Astro.props.class;
const t = getTranslation(lang || siteConfig.lang);
---

<div class:list={["flex flex-wrap items-center gap-x-5 gap-y-2 text-xs swiss-num text-(--ink-muted)", className]}>
    <!-- publish date -->
    <div class="flex items-center gap-1.5">
        <span class="text-(--ink-faint) uppercase">PUB</span>
        <time datetime={published.toISOString()} class="text-(--ink-body)">{formatDateToYYYYMMDD(published)}</time>
    </div>

    <!-- update date -->
    {!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
        <div class="flex items-center gap-1.5">
            <span class="text-(--ink-faint) uppercase">UPD</span>
            <time datetime={updated.toISOString()} class="text-(--ink-body)">{formatDateToYYYYMMDD(updated)}</time>
        </div>
    )}

    <!-- categories -->
    <div class="flex items-center gap-1.5">
        <span class="text-(--ink-faint) uppercase">CAT</span>
        <a href={getCategoryUrl(category, lang || siteConfig.lang)} aria-label={`View all posts in the ${category} category`}
           class="text-(--ink-body) hover:text-(--primary) transition-colors whitespace-nowrap">
            {category ? category : <span data-i18n="uncategorized">{t[I18nKey.uncategorized]}</span>}
        </a>
    </div>

    <!-- tags -->
    <div class:list={["items-center gap-2", {"flex": !hideTagsForMobile, "hidden md:flex": hideTagsForMobile}]}>
        {(tags && tags.length > 0) && tags.map((tag) => (
            <a href={getTagUrl(tag, lang || siteConfig.lang)} aria-label={`View all posts with the ${tag.trim()} tag`}
               class="text-(--ink-muted) hover:text-(--primary) transition-colors whitespace-nowrap">
                #{tag.trim()}
            </a>
        ))}
        {!(tags && tags.length > 0) && <span class="text-(--ink-faint)" data-i18n="noTags">{t[I18nKey.noTags]}</span>}
    </div>
</div>
