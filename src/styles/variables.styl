/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(12, 12, 11, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 0px
  --content-delay 100ms
  --ease-swiss cubic-bezier(0.16, 1, 0.3, 1)
  --ease-swiss-out cubic-bezier(0.22, 1, 0.36, 1)

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.56 0.22 var(--hue)) oklch(0.66 0.21 var(--hue))
  --page-bg: #F6F6F3 #0C0C0B
  --card-bg: transparent transparent
  --surface-bg: #EFEFEB #141413
  --surface-elevated: #FAFAF8 #171715

  --ink-strong: #0E0E0D #F4F4F0
  --ink-body: #262624 #D8D8D2
  --ink-muted: #666661 #8E8E88
  --ink-faint: #9E9E98 #54544F

  --btn-content: #0E0E0D #F4F4F0

  --btn-regular-bg: black(0.045) white(0.06)
  --btn-regular-bg-hover: black(0.09) white(0.12)
  --btn-regular-bg-active: black(0.14) white(0.18)

  --btn-plain-bg-hover: black(0.04) white(0.06)
  --btn-plain-bg-active: black(0.08) white(0.10)

  --btn-card-bg-hover: black(0.03) white(0.04)
  --btn-card-bg-active: black(0.06) white(0.08)

  --enter-btn-bg: transparent
  --enter-btn-bg-hover: black(0.05) white(0.06)
  --enter-btn-bg-active: black(0.09) white(0.10)

  --deep-text: #0E0E0D

  --title-active: oklch(0.50 0.22 var(--hue)) oklch(0.62 0.21 var(--hue))

  --line-divider: black(0.12) white(0.13)
  --line-strong: black(0.85) white(0.85)
  --line-color: black(0.15) white(0.16)
  --inline-code-bg: black(0.055) white(0.08)
  --inline-code-color: #0E0E0D #F4F4F0
  --selection-bg: oklch(0.88 0.09 var(--hue)) oklch(0.38 0.12 var(--hue))
  --codeblock-selection: oklch(0.38 0.10 var(--hue))
  --codeblock-bg: #1B1C1D #191A1B
  --codeblock-topbar-bg: #242628 #202123

  --license-block-bg: black(0.03) white(0.035)

  --link-underline: black(0.28) white(0.30)
  --link-hover: var(--primary) var(--primary)
  --link-active: oklch(0.48 0.22 var(--hue)) oklch(0.60 0.20 var(--hue))

  --float-panel-bg: #FAFAF8 #151513

  --scrollbar-bg-light: black(0.28)
  --scrollbar-bg-hover-light: black(0.48)
  --scrollbar-bg-active-light: black(0.65)

  --scrollbar-bg-dark: white(0.28)
  --scrollbar-bg-hover-dark: white(0.48)
  --scrollbar-bg-active-dark: white(0.65)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.55 0.14 165) oklch(0.72 0.14 165)
  --admonitions-color-note: oklch(0.52 0.14 250) oklch(0.72 0.14 250)
  --admonitions-color-important: oklch(0.54 0.16 305) oklch(0.72 0.16 305)
  --admonitions-color-warning: oklch(0.58 0.16 65) oklch(0.75 0.16 65)
  --admonitions-color-caution: oklch(0.56 0.22 25) oklch(0.66 0.21 25)

  --toc-badge-bg: black(0.07) white(0.10)
  --toc-btn-hover: black(0.04) white(0.05)
  --toc-btn-active: black(0.08) white(0.09)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1.5rem)
  --toc-item-active: var(--primary) var(--primary)
})
