---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	langSwitchHref?: string;
	hideSidebar?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	langSwitchHref,
	hideSidebar = false,
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "4.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} langSwitchHref={langSwitchHref}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<header id="top-row" class="z-50 sticky top-0 w-full bg-(--page-bg)/92 backdrop-blur-md border-b border-(--line-divider) transition-colors duration-200">
    <div id="navbar-wrapper" class="max-w-(--page-width) px-5 md:px-8 mx-auto">
        <Navbar lang={lang}></Navbar>
    </div>
</header>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`relative z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div class="relative w-full z-30 pt-6 md:pt-10" style={siteConfig.banner.enable ? `margin-top: ${mainPanelTop}` : undefined}>
    <div class="relative max-w-(--page-width) mx-auto">
        <div id="main-grid" class="w-full mx-auto px-5 md:px-8 flex flex-col lg:flex-row gap-y-10 lg:gap-x-12">
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center " +
                                   "px-3 right-4 top-[-3.25rem] bg-black/75 hover:bg-black/90 h-8", {"hover:pr-8": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-(--primary) right-3 text-xs opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}

            <div id="sidebar-col" class:list={[
                "transition-swup-fade",
                hideSidebar
                    ? "hidden"
                    : "order-2 lg:order-1 w-full lg:w-[15rem] lg:shrink-0 lg:border-r lg:border-(--line-divider) lg:pr-8"
            ]}>
                {!hideSidebar && <SideBar class="onload-animation" headings={headings} lang={lang}></SideBar>}
            </div>

            <main id="swup-container" class="transition-swup-fade order-1 lg:order-2 flex-1 min-w-0">
                <div id="content-wrapper">
                    <slot></slot>
                    <div class="footer onload-animation hidden lg:block">
                        <Footer lang={lang}></Footer>
                    </div>
                </div>
            </main>

            <div class="footer order-3 onload-animation block lg:hidden">
            <Footer lang={lang}></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- TOC floating rail on wide viewports -->
<div class="fixed top-0 left-0 right-0 z-20 pointer-events-none hidden 2xl:block">
    <div class="relative max-w-(--page-width) mx-auto">
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-24 -right-(--toc-width) w-(--toc-width) pointer-events-auto",
            {"toc-hide": siteConfig.banner.enable}]}
        >
            <div id="toc-inner-wrapper" class="w-(--toc-width) max-h-[calc(100vh-8rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full transition-swup-fade">
                    <div class="h-4 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-4 w-full"></div>
                </div>
            </div>
        </div>}

        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>
